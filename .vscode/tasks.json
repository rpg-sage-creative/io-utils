{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "run-test-all",
			"command": "pnpm",
			"args": ["test"],
			"type": "shell",
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": false
			}
		},
		{
			"label": "run-test-dot-js",
			"command": "pnpm",
			"args": ["test:dot-test-dot-js", "${file}"],
			"type": "shell",
			"group": {
				"kind": "test",
				"isDefault": "**/test/**/*.test.js"
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": false
			}
		},
		{
			"label": "run-test-dot-ts",
			"command": "pnpm",
			"args": ["test:dot-test-dot-ts", "${file}"],
			"type": "shell",
			"group": {
				"kind": "test",
				"isDefault": "**/test/**/*.test.ts"
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": false
			}
		},
		{
			"label": "run-dot-ts",
			"command": "bash",
			"args": [
				"./scripts/test-src-ts-file.sh",
				"${file}"
			],
			"type": "shell",
			"group": {
				"kind": "test",
				"isDefault": "**/src/**/*.ts"
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": false
			}
		},
		{
			"label": "run-build",
			"command": "pnpm",
			"args": ["build"],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": false
			}
		}
	]
}